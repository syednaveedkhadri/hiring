generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Position {
  id                            String   @id @default(uuid())
  title                         String
  department                    String?
  vacancies                     Int
  seniorityLevel                String?
  jobDescription                String?  @db.Text
  mandatoryRequirements         String?  @db.Text
  preferredRequirements         String?  @db.Text
  minimumExperience             Float?
  preferredExperience           Float?
  salaryMin                     Decimal?
  salaryMax                     Decimal?
  currency                      String?  @default("KWD")
  requiredSkills                String?  @db.Text
  preferredSkills               String?  @db.Text
  educationRequirements         String?  @db.Text
  certificationRequirements     String?  @db.Text
  joiningAvailabilityPreference String?  @db.Text
  specialRequirements           String?  @db.Text
  whatMattersMost               String?  @db.Text
  majorConcerns                 String?  @db.Text
  aiEvaluationInstructions      String?  @db.Text
  status                        String   @default("OPEN")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  candidates    Candidate[]
  aiEvaluations AIEvaluation[]
}

model Candidate {
  id                  String   @id @default(uuid())
  candidateCode       String   @unique
  fullName            String
  phone               String?
  whatsapp            String?
  email               String?
  currentCity         String?
  currentCountry      String?
  currentCompany      String?
  currentJobTitle     String?
  totalExperience     Float?
  relevantExperience  Float?
  currentSalary       Decimal?
  expectedSalary      Decimal?
  salaryCurrency      String?  @default("INR")
  noticePeriod        String?
  joiningAvailability String?
  status              String   @default("NEW")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  photo          CandidatePhoto?
  documents      CandidateDocument[]
  cv             CandidateCV?
  skills         CandidateSkill[]
  education      CandidateEducation[]
  certifications CandidateCertification[]
  languages      CandidateLanguage[]
  employment     CandidateEmployment[]
  notes          CandidateNote[]
  interviews     Interview[]
  aiEvaluations  AIEvaluation[]
  rankings       CandidateRanking[]

  @@index([positionId])
  @@index([fullName])
  @@index([phone])
  @@index([status])
}

model CandidatePhoto {
  id          String   @id @default(uuid())
  candidateId String   @unique
  fileUrl     String
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateDocument {
  id           String   @id @default(uuid())
  candidateId  String
  documentType String
  fileName     String
  fileUrl      String
  mimeType     String?
  createdAt    DateTime @default(now())

  candidate Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cv        CandidateCV?

  @@index([candidateId])
}

model CandidateSkill {
  id              String @id @default(uuid())
  candidateId     String
  skill           String
  yearsExperience Float?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateEducation {
  id             String  @id @default(uuid())
  candidateId    String
  qualification  String
  institution    String?
  specialization String?
  startYear      Int?
  endYear        Int?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateCertification {
  id                  String    @id @default(uuid())
  candidateId         String
  name                String
  issuingOrganization String?
  issueDate           DateTime?
  expiryDate          DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateLanguage {
  id          String  @id @default(uuid())
  candidateId String
  language    String
  proficiency String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateEmployment {
  id               String    @id @default(uuid())
  candidateId      String
  company          String
  jobTitle         String
  startDate        DateTime?
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  description      String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateNote {
  id          String   @id @default(uuid())
  candidateId String
  note        String
  createdBy   String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateCV {
  id               String    @id @default(uuid())
  candidateId      String    @unique
  documentId       String    @unique
  extractedText    String?   @db.Text
  parsedData       Json?
  extractionStatus String    @default("PENDING")
  extractionError  String?
  extractedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  candidate Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  document  CandidateDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model CandidateSequence {
  id         String   @id @default("singleton")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Interview {
  id                String   @id @default(uuid())
  candidateId       String
  interviewerId     String?
  interviewType     String   @default("TECHNICAL")
  interviewDate     DateTime @default(now())
  interviewLocation String?
  overallNotes      String?  @db.Text
  strengths         String?  @db.Text
  concerns          String?  @db.Text
  status            String   @default("COMPLETED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  candidate Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scores    InterviewScore[]
  questions InterviewQuestion[]

  @@index([candidateId])
  @@index([interviewDate])
}

model InterviewScore {
  id          String  @id @default(uuid())
  interviewId String
  category    String
  score       Int
  notes       String? @db.Text

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model InterviewQuestion {
  id                     String  @id @default(uuid())
  interviewId            String
  question               String  @db.Text
  questionType           String? // TECHNICAL, TRICKY, PRACTICAL
  competency             String? @db.Text
  expectedAnswerGuidance String? @db.Text
  performance            String? // POOR, FAIR, GOOD, VERY_GOOD, EXCELLENT
  answer                 String? @db.Text
  notes                  String? @db.Text

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model AIEvaluation {
  id                  String   @id @default(uuid())
  candidateId         String
  positionId          String
  overallScore        Float
  confidence          String
  recommendation      String
  jobRequirementScore Float?
  experienceScore     Float?
  skillsScore         Float?
  technicalScore      Float?
  interviewScore      Float?
  practicalScore      Float?
  salaryFitScore      Float?
  availabilityScore   Float?
  educationScore      Float?
  certificationScore  Float?
  strengths           Json
  weaknesses          Json
  requirementGaps     Json
  missingInformation  Json
  evidence            Json?
  summary             String   @db.Text
  model               String?
  promptVersion       String?
  positionSnapshot    Json
  candidateSnapshot   Json
  createdAt           DateTime @default(now())

  candidate Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position  Position           @relation(fields: [positionId], references: [id], onDelete: Cascade)
  rankings  CandidateRanking[]

  @@index([candidateId])
  @@index([positionId])
  @@index([overallScore])
  @@index([createdAt])
}

model CandidateRanking {
  id           String   @id @default(uuid())
  candidateId  String
  positionId   String
  evaluationId String
  rank         Int
  totalCount   Int
  recordedAt   DateTime @default(now())

  candidate  Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evaluation AIEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([positionId])
  @@index([evaluationId])
  @@index([recordedAt])
}
